        <mxCell id="REFRESH_TOKEN_a" parent="REFRESH_TOKEN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_refresh_token&lt;/u&gt;&lt;br&gt;token_hash&lt;br&gt;family_id&lt;br&gt;issued_at&lt;br&gt;expires_at&lt;br&gt;used_at&lt;br&gt;revoked_at&lt;br&gt;#id_user" vertex="1">
          <mxGeometry height="166" width="200" y="26" as="geometry" />
        </mxCell>
        <object label="REFRESH_TOKEN" tags="doc" id="CARD_REFRESH_TOKEN">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="200" width="300" x="1900" y="250" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_REFRESH_TOKEN_t" parent="CARD_REFRESH_TOKEN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Jeton de rafraîchissement d'une session (D15). Le jeton d'accès reste un JWT non stocké.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Révoquer une session et détecter un jeton volé. family_id = session d'un appareil.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Haché, usage unique (RG77)&lt;br&gt;• Réutilisation → famille révoquée (RG78)&lt;br&gt;• Déconnexion / suppression du compte (RG79)" vertex="1">
          <mxGeometry height="172" width="300" y="28" as="geometry" />
        </mxCell>
        <mxCell id="fk_refresh_token_user" edge="1" parent="1" source="REFRESH_TOKEN" style="rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;curved=0;" target="USER_ACCOUNT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="REMINDER" link="data:action/json,{&quot;actions&quot;:[{&quot;toggle&quot;:{&quot;cells&quot;:[&quot;CARD_REMINDER&quot;]}}]}" id="REMINDER">
          <mxCell parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="154" width="200" x="1680" y="900" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="REMINDER_a" parent="REMINDER" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_reminder&lt;/u&gt;&lt;br&gt;reminder_type&lt;br&gt;label&lt;br&gt;due_at&lt;br&gt;done_at&lt;br&gt;#id_pet" vertex="1">
          <mxGeometry height="128" width="200" y="26" as="geometry" />
        </mxCell>
        <object label="REMINDER" tags="doc" id="CARD_REMINDER">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="190" width="300" x="1900" y="900" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_REMINDER_t" parent="CARD_REMINDER" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Soin à faire à une échéance (D3).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;La maquette crée des rappels sans soin passé, avec « effectué » et un type « autre » : impossible avec next_due_date.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• 3 types, done_at vide = à faire (RG28)&lt;br&gt;• Échéance &amp;lt; 24 h → notification (RG83)" vertex="1">
          <mxGeometry height="162" width="300" y="28" as="geometry" />
        </mxCell>
        <mxCell id="fk_reminder_pet" edge="1" parent="1" source="REMINDER" style="rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;curved=0;" target="PET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="NOTIFICATION" link="data:action/json,{&quot;actions&quot;:[{&quot;toggle&quot;:{&quot;cells&quot;:[&quot;CARD_NOTIFICATION&quot;]}}]}" id="NOTIFICATION">
          <mxCell parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="211" width="200" x="2480" y="560" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="NOTIFICATION_a" parent="NOTIFICATION" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_notification&lt;/u&gt;&lt;br&gt;notification_type&lt;br&gt;title&lt;br&gt;created_at&lt;br&gt;read_at&lt;br&gt;#id_user&lt;br&gt;#id_pet&lt;br&gt;#id_alert&lt;br&gt;#id_reminder" vertex="1">
          <mxGeometry height="185" width="200" y="26" as="geometry" />
        </mxCell>
        <object label="NOTIFICATION" tags="doc" id="CARD_NOTIFICATION">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="210" width="300" x="2700" y="560" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_NOTIFICATION_t" parent="CARD_NOTIFICATION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Élément du fil de notifications d'une personne (D4).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Lu / non lu par personne, et notifications qui ne sont pas des alertes. ALERT reste l'événement. #id_alert et #id_reminder facultatifs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Une ligne par destinataire (RG83)&lt;br&gt;• Pas de push santé si health_notifications = false (RG84)" vertex="1">
          <mxGeometry height="182" width="300" y="28" as="geometry" />
        </mxCell>
        <mxCell id="fk_notification_user" edge="1" parent="1" source="NOTIFICATION" style="rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;curved=0;" target="USER_ACCOUNT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fk_notification_pet" edge="1" parent="1" source="NOTIFICATION" style="rounded=1;html=1;endArrow=block;endFill=1;edgeStyle=entityRelationEdgeStyle;curved=0;" target="PET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fk_notification_alert" edge="1" parent="1" source="NOTIFICATION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="ALERT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fk_notification_reminder" edge="1" parent="1" source="NOTIFICATION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="REMINDER">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
