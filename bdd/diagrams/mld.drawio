        <mxCell id="fk_invitation_pet" edge="1" parent="1" source="INVITATION" style="rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;edgeStyle=entityRelationEdgeStyle;curved=0;" target="PET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="INVITATION" tags="doc" id="CARD_INVITATION">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="770" y="420" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_INVITATION_t" parent="CARD_INVITATION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Invitation d'un co-propriétaire sur un animal, par e-mail.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;L'invité peut ne pas avoir de compte : on ne peut pas créer de ligne PET_OWNER avant son acceptation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Une seule invitation en attente par animal et par e-mail (RG76)&lt;br&gt;• Acceptée → l'invité devient propriétaire second (RG75)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
