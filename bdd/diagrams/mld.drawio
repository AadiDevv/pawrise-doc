        <object label="📖 Afficher / masquer toute la documentation" link="data:action/json,{&quot;actions&quot;:[{&quot;toggle&quot;:{&quot;tags&quot;:[&quot;doc&quot;]}}]}" id="DOC_ALL">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1">
            <mxGeometry height="44" width="340" x="-300" y="1415" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="LEG" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontColor=#333333;" value="Légende — MLD App-DB (Merise)" vertex="1">
          <mxGeometry height="530" width="1150" x="-300" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="LEG_t" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;" value="&lt;b&gt;Rectangle&lt;/b&gt; = table · &lt;u&gt;souligné&lt;/u&gt; = clé primaire · &lt;b&gt;#&lt;/b&gt; = clé étrangère (même nom que la clé primaire référencée)&lt;br&gt;&lt;b&gt;Flèche&lt;/b&gt; = de la table qui porte la clé étrangère vers la table référencée.&lt;br&gt;&lt;b&gt;Couleurs&lt;/b&gt; : &lt;span style=&quot;background-color:#dae8fc;&quot;&gt;&amp;nbsp;bleu&amp;nbsp;&lt;/span&gt; table issue d'une entité · &lt;span style=&quot;background-color:#fff2cc;&quot;&gt;&amp;nbsp;jaune&amp;nbsp;&lt;/span&gt; table de liaison issue d'une association N-N · &lt;span style=&quot;background-color:#d5e8d4;&quot;&gt;&amp;nbsp;vert&amp;nbsp;&lt;/span&gt; PET, entité pivot&lt;br&gt;&lt;b&gt;Documentation&lt;/b&gt; : en mode lecture, clic sur une table pour afficher / masquer sa fiche ; bouton ci-dessus pour toutes les afficher.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles de passage MCD → MLD appliquées&lt;/b&gt;&lt;br&gt;• Association binaire (0,n / 1,1) : la clé primaire côté n migre en clé étrangère côté 1,1 ; l'ellipse disparaît.&lt;br&gt;• Association binaire (0,n / 0,1) : clé étrangère côté 0,1, facultative → PET.#ordinal_number (véto traitant, &lt;i&gt;suivre&lt;/i&gt;), ALERT.#id_geo_zone (&lt;i&gt;provoquer&lt;/i&gt;), ESCALATION.#ordinal_number (véto en charge, &lt;i&gt;prendre_en_charge&lt;/i&gt;).&lt;br&gt;• Association (1,1 / 0,1) &lt;i&gt;aboutir&lt;/i&gt; : ESCALATION.#id_conversation, clé étrangère unique.&lt;br&gt;• Association (n / n) : nouvelle table, clé primaire = clés étrangères + attributs portés → PET_BREED (&lt;i&gt;avoir_race&lt;/i&gt;), PET_OWNER (&lt;i&gt;posséder&lt;/i&gt;), PET_GEO_ZONE (&lt;i&gt;surveiller&lt;/i&gt;), VET_CLINIC (&lt;i&gt;exercer&lt;/i&gt;).&lt;br&gt;• Identification relative (1,1) : clé primaire composée des clés étrangères + identifiant local → COLLAR_ASSIGNMENT, PET_VET_ACCESS, CONSENT.&lt;br&gt;&lt;br&gt;&lt;b&gt;Contraintes non représentables en MLD&lt;/b&gt; (MPD ou applicatif) :&lt;br&gt;• les races d'un animal appartiennent à son espèce ; une seule race principale (is_primary) par animal&lt;br&gt;• à un instant donné : une seule affectation par animal et par collier, un seul accès actif par couple animal / véto, un seul consentement actif par type, un seul abonnement actif par collier&lt;br&gt;• une géozone ne surveille que les animaux de son créateur&lt;br&gt;• seul un vétérinaire partenaire (is_partner) peut recevoir un accès (PET_VET_ACCESS) ou une escalade&lt;br&gt;• données mesurées en continu (GPS, capteurs, batterie) : TimescaleDB, hors App-DB&lt;br&gt;&lt;br&gt;Règles de gestion complètes : fiche MCD (RG1 à RG72)." vertex="1">
          <mxGeometry height="486" width="1120" x="-286" y="1514" as="geometry" />
        </mxCell>
        <mxCell id="DOC" parent="0" value="Documentation" />
        <object label="SPECIES" tags="doc" id="CARD_SPECIES">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="184" width="300" x="2170" y="1300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_SPECIES_t" parent="CARD_SPECIES" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Référentiel des espèces (chien, chat…).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Un code immuable plutôt qu'un libellé libre : pas de variantes de saisie.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Codes uniques et immuables (RG1)&lt;br&gt;• L'espèce d'un animal est immuable (RG6)" vertex="1">
          <mxGeometry height="156" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="BREED_TYPE" tags="doc" id="CARD_BREED_TYPE">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="170" width="300" x="2620" y="1600" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_BREED_TYPE_t" parent="CARD_BREED_TYPE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Référentiel des types de race (groupes, catégories).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Classe les races indépendamment de l'espèce.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Codes uniques et immuables (RG1)" vertex="1">
          <mxGeometry height="142" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="BREED" tags="doc" id="CARD_BREED">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="198" width="300" x="2620" y="1300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_BREED_t" parent="CARD_BREED" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Référentiel des races, rattachées à une espèce et à un type.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;#species_code permet de contrôler que les races d'un animal appartiennent à son espèce (RG3).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Codes uniques et immuables (RG1)&lt;br&gt;• Nom unique au sein d'une espèce (RG2)" vertex="1">
          <mxGeometry height="170" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="PET" tags="doc" id="CARD_PET">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="270" width="300" x="1620" y="900" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_PET_t" parent="CARD_PET" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;L'animal suivi, entité centrale du modèle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Âge calculé depuis birth_date (RG7), poids historisé dans HEALTH_ENTRY (RG8) : valeur unique → PET, donnée datée → HEALTH_ENTRY (RG30).&lt;br&gt;#ordinal_number = vétérinaire traitant, facultatif (RG43).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Espèce immuable (RG6)&lt;br&gt;• identification_number unique si renseigné (RG9)&lt;br&gt;• Supprimé avec son dernier propriétaire (RG16)" vertex="1">
          <mxGeometry height="242" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="PET_BREED" tags="doc" id="CARD_PET_BREED">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="1970" y="1470" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_PET_BREED_t" parent="CARD_PET_BREED" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Races d'un animal (un croisement en a plusieurs).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Table issue de l'association N-N &lt;i&gt;avoir_race&lt;/i&gt;, qui porte is_primary.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Races de l'espèce de l'animal (RG3)&lt;br&gt;• Au plus une race principale (RG4)&lt;br&gt;• Aucune ligne = race inconnue (RG5)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="USER_ACCOUNT" tags="doc" id="CARD_USER_ACCOUNT">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="1620" y="250" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_USER_ACCOUNT_t" parent="CARD_USER_ACCOUNT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Compte d'un propriétaire.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;payment_customer_ref = client Stripe ; factures et paiements restent chez Stripe (RG63). La position n'est jamais stockée (RG19).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Email unique (RG10)&lt;br&gt;• CGU acceptées à l'inscription (RG11)&lt;br&gt;• payment_customer_ref unique (RG64)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="PET_OWNER" tags="doc" id="CARD_PET_OWNER">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="1070" y="480" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_PET_OWNER_t" parent="CARD_PET_OWNER" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Propriétaires d'un animal (plusieurs possibles).&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Table issue de l'association N-N &lt;i&gt;posséder&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Rôle chief / secondary ; exactement un chef par animal (RG15, RG73)&lt;br&gt;• Transfert du rôle de chef (RG74)&lt;br&gt;• Suppression d'un compte : seul son lien disparaît ; dernier propriétaire supprimé → animal et données supprimés (RG16)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="DEVICE" tags="doc" id="CARD_DEVICE">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="198" width="300" x="1020" y="40" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_DEVICE_t" parent="CARD_DEVICE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Téléphone enregistré pour les notifications push.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Un utilisateur peut avoir plusieurs appareils ; chaque alerte part sur tous (RG50).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• push_token unique (RG17)&lt;br&gt;• Token invalidé → appareil supprimé (RG18)" vertex="1">
          <mxGeometry height="170" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="CONSENT" tags="doc" id="CARD_CONSENT">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="240" width="300" x="1020" y="250" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_CONSENT_t" parent="CARD_CONSENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Historique des consentements RGPD d'un utilisateur.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Identification relative (utilisateur, type, date) : une révocation puis un nouvel accord donnent deux lignes, rien n'est écrasé.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Un seul consentement actif par type (RG12)&lt;br&gt;• Révocation datée, jamais supprimée (RG13)&lt;br&gt;• Types MVP : CGU/confidentialité, IA externe (RG14)" vertex="1">
          <mxGeometry height="212" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="COLLAR" tags="doc" id="CARD_COLLAR">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="2820" y="945" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_COLLAR_t" parent="CARD_COLLAR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Collier physique, identifié par son numéro de série.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Batterie et position sont des séries temporelles : TimescaleDB, hors App-DB (RG24).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Seul un collier actif peut être affecté (RG23)&lt;br&gt;• Au plus un abonnement actif à la fois (RG60)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="COLLAR_ASSIGNMENT" tags="doc" id="CARD_COLLAR_ASSIGNMENT">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="2170" y="975" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_COLLAR_ASSIGNMENT_t" parent="CARD_COLLAR_ASSIGNMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Historique des affectations collier ↔ animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;assigned_at dans la clé : un même couple peut revenir, et chaque donnée capteur est rattachée au bon animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Un collier par animal et un animal par collier à la fois (RG20, RG21)&lt;br&gt;• Jamais supprimée : clôturée par unassigned_at (RG22)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="HEALTH_ENTRY" tags="doc" id="CARD_HEALTH_ENTRY">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="240" width="300" x="1080" y="1330" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_HEALTH_ENTRY_t" parent="CARD_HEALTH_ENTRY" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Carnet de santé : vaccins, traitements, pesées, allergies…&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Une table typée par entry_type plutôt qu'une table par type. Le carnet est une vue PET + HEALTH_ENTRY (RG30).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• 9 types d'entrée (RG25)&lt;br&gt;• Champs remplis selon le type (RG26)&lt;br&gt;• Poids actuel = dernière pesée (RG27)&lt;br&gt;• next_due_date déclenche un rappel (RG28)" vertex="1">
          <mxGeometry height="212" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="DOCUMENT" tags="doc" id="CARD_DOCUMENT">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="1620" y="1740" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_DOCUMENT_t" parent="CARD_DOCUMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Pièce jointe (PDF, image) d'une entrée de santé.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Fichier en stockage objet ; la base ne garde que storage_ref (RG71).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• PDF et images uniquement (RG67)&lt;br&gt;• Ajout véto : accès actif requis (RG68)&lt;br&gt;• Supprimé avec son entrée (RG69)&lt;br&gt;• Inclus dans l'export véto (RG70)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="GEO_ZONE_SECURITY" tags="doc" id="CARD_GEO_ZONE_SECURITY">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="1480" y="500" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_GEO_ZONE_SECURITY_t" parent="CARD_GEO_ZONE_SECURITY" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Zone circulaire qui protège un animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Cercle centre + rayon (RG31). Zone sécurisée : alerte en sortie ; zone interdite : alerte en entrée (RG32). #id_pet : la zone appartient au chien (révisé le 2026-10-30, D5), PET_GEO_ZONE supprimée.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Gérée par tous les propriétaires de l'animal (RG33)&lt;br&gt;• Alertes activables par zone (RG34)&lt;br&gt;• Supprimée avec l'animal (RG36)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="VETERINARIAN" tags="doc" id="CARD_VETERINARIAN">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="470" y="1100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_VETERINARIAN_t" parent="CARD_VETERINARIAN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Annuaire des vétérinaires, partenaires ou non.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Numéro ordinal : unique et immuable, clé de correspondance avec la Vet-DB, sans FK entre les deux bases (RG37).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Inscription au Portail → passe partenaire (RG38)&lt;br&gt;• Dispos et RDV lus via l'API du Portail (RG42)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="CLINIC" tags="doc" id="CARD_CLINIC">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="198" width="300" x="-80" y="1070" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_CLINIC_t" parent="CARD_CLINIC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Lieu d'exercice des vétérinaires.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Entité à part : en urgence on cherche un lieu, et l'adresse n'est pas répétée pour chaque véto du cabinet.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Coordonnées comparées à la position du téléphone, non stockée (RG19)&lt;br&gt;• has_emergency_service filtre la recherche d'urgence" vertex="1">
          <mxGeometry height="170" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="VET_CLINIC" tags="doc" id="CARD_VET_CLINIC">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="184" width="300" x="185" y="1140" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_VET_CLINIC_t" parent="CARD_VET_CLINIC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Cliniques où exerce chaque vétérinaire.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Table issue de l'association N-N &lt;i&gt;exercer&lt;/i&gt; : un véto peut exercer dans plusieurs cliniques.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Tout véto exerce dans au moins une clinique (1,n)" vertex="1">
          <mxGeometry height="156" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="PET_VET_ACCESS" tags="doc" id="CARD_PET_VET_ACCESS">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="240" width="300" x="1020" y="1250" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_PET_VET_ACCESS_t" parent="CARD_PET_VET_ACCESS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Historique des accès d'un véto partenaire aux données d'un animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Un accès peut être accordé, révoqué puis ré-accordé : access_granted_at entre dans la clé.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Véto partenaire uniquement (RG39)&lt;br&gt;• Source : propriétaire ou escalade IA, toujours validé par un propriétaire (RG40)&lt;br&gt;• Un seul accès actif ; révocation datée, jamais supprimée (RG41)" vertex="1">
          <mxGeometry height="212" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="ALERT" tags="doc" id="CARD_ALERT">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="226" width="300" x="2420" y="560" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_ALERT_t" parent="CARD_ALERT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Alerte déclenchée pour un animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;#id_geo_zone facultatif : seules les alertes de zone y sont reliées (RG48).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• 5 types (RG46), 3 gravités (RG47)&lt;br&gt;• Jamais supprimée (RG49)&lt;br&gt;• explanation obligatoire (RG51)&lt;br&gt;• Acquittement partagé entre propriétaires (RG52)" vertex="1">
          <mxGeometry height="198" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="CONVERSATION" tags="doc" id="CARD_CONVERSATION">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="1020" y="560" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_CONVERSATION_t" parent="CARD_CONVERSATION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Fil de chat IA portant sur un animal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Rattachée à l'animal et au propriétaire qui l'a ouverte.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Visible par son initiateur uniquement (RG53)&lt;br&gt;• Au plus une escalade (RG54)&lt;br&gt;• Jamais supprimée, sauf avec le compte ou l'animal (RG58)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="MESSAGE" tags="doc" id="CARD_MESSAGE">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="470" y="600" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_MESSAGE_t" parent="CARD_MESSAGE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Message d'une conversation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;model_version, sources et confidence_score tracent chaque réponse de l'IA.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• sender_role : propriétaire, IA ou véto ; champs IA pour l'IA seulement (RG59)&lt;br&gt;• Message véto seulement si la conversation lui est escaladée (RG57)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="ESCALATION" tags="doc" id="CARD_ESCALATION">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="254" width="300" x="1020" y="840" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_ESCALATION_t" parent="CARD_ESCALATION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Passage d'une conversation IA vers un véto partenaire.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;#id_conversation unique : au plus une escalade par conversation. #ordinal_number vide tant qu'aucun véto ne l'a prise en charge.&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Statuts : en attente, prise en charge, clôturée (RG55)&lt;br&gt;• Prise en charge → accès aux données, validé par le propriétaire (RG56)" vertex="1">
          <mxGeometry height="226" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="SUBSCRIPTION" tags="doc" id="CARD_SUBSCRIPTION">
          <mxCell parent="DOC" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;collapsible=0;fontStyle=1;fontColor=#333333;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#999999;shadow=1;align=left;spacingLeft=10;" vertex="1" visible="0">
            <mxGeometry height="212" width="300" x="2320" y="250" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="CARD_SUBSCRIPTION_t" parent="CARD_SUBSCRIPTION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Rôle&lt;/b&gt;&lt;br&gt;Abonnement Stripe couvrant un collier.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi&lt;/b&gt;&lt;br&gt;Un abonnement par collier ; factures et paiements sont consultés chez Stripe (RG63).&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Un seul abonnement actif par collier (RG60)&lt;br&gt;• Statut mis à jour par webhooks (RG62)&lt;br&gt;• Payé par le souscripteur (RG65)&lt;br&gt;• Période de grâce calculée, non stockée (RG66)" vertex="1">
          <mxGeometry height="184" width="300" y="28" as="geometry" />
        </mxCell>
        <object label="INVITATION" link="data:action/json,{&quot;actions&quot;:[{&quot;toggle&quot;:{&quot;cells&quot;:[&quot;CARD_INVITATION&quot;]}}]}" id="INVITATION">
          <mxCell parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
